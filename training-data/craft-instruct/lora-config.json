{
  "_readme": "LLaMA-Factory LoRA 训练配置：DreamCraft-1.5B（AI文创方案生成领域微调）。用 lltuner/zhihu_llama_factory 同名 webui 可直接导入。数据集路径相对训练环境，上传 train.jsonl 后按 dataset_info.json 说明注册。",
  "base_model": "Qwen/Qwen2.5-1.5B-Instruct",
  "task": "sft",
  "method": "lora",
  "dataset": "dreamcraft_instruct",
  "dataset_info": {
    "dreamcraft_instruct": {
      "file_name": "train.jsonl",
      "formatting": "alpaca",
      "columns": { "prompt": "instruction", "response": "output" }
    }
  },
  "output_dir": "dreamcraft-1.5b-lora",
  "per_device_train_batch_size": 8,
  "gradient_accumulation_steps": 2,
  "learning_rate": 1e-4,
  "num_train_epochs": 3,
  "max_samples": 100000,
  "cutoff_len": 1024,
  "lora_rank": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "lora_target": "all",
  "bf16": true,
  "logging_steps": 10,
  "save_steps": 100,
  "plot_loss": true,
  "warmup_ratio": 0.1,
  "lr_scheduler_type": "cosine"
}
