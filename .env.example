# ============================================================
# Dreamcore 环境变量模板（复制为 .env 后填写，.env 不入库）
# 说明：
#   - DASHSCOPE/DEEPSEEK/MIMO 三个密钥配置在 Netlify/Vercel 控制台
#     (Site settings → Environment variables)，前端零密钥
#   - VITE_SUPABASE_* 两个变量写入 .env（anon key 本身是公开的，
#     安全由 RLS 策略保证；service_role key 绝不进前端)
# ============================================================

# ---- AI 服务商密钥（配置在 Netlify 控制台，勿写死在前端）----
# 阿里云百炼 https://bailian.console.aliyun.com （AI评分 qwen-vl + AI文创图像生成）
DASHSCOPE_API_KEY=
# 深度求索 https://platform.deepseek.com （AI陪练/策展/合伙人文本对话）
DEEPSEEK_API_KEY=
# 小米 MiMo https://api.xiaomimimo.com （备用降级，可选）
MIMO_API_KEY=

# ---- Supabase（阶段1接入后填写）----
# Dashboard → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
